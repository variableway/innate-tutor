# Copy to .env before the first start:
#   cp .env.example .env
#
# Local/trusted-network defaults only. Change all *-local-dev values before
# exposing any service beyond 127.0.0.1.

TZ=Asia/Shanghai

# LLM for OpenMAIC. Prefer DEFAULT_MODEL=provider:model.
# OpenAI-compatible (LLM_*) and/or Anthropic-compatible (ANTHROPIC_*).
# Local tip: copy from innate-aiswitcher providers (minimax-codex / volcengine-claude / xiaomi-claude).
# DeepTutor ignores process-level model config; set models in its Settings UI.
DEFAULT_MODEL=openai:gpt-5.4-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODELS=
# Xiaomi/MiMo Token Plan OpenAI-compatible (/v1). Example DEFAULT_MODEL=xiaomi:mimo-v2.5-pro
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MODELS=

# Optional bundled LightRAG profile. These values are ignored by the default
# no-RAG startup. Indexing requires a working embedding model and exact dimension.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LIGHTRAG_LLM_MODEL=gpt-5.4-mini

# Local infrastructure credentials. LIGHTRAG_API_KEY is needed only when the
# `rag-lightrag` profile is enabled.
POSTGRES_PASSWORD=innate-local-dev
OPENMAIC_PERSISTENCE_TOKEN=openmaic-local-dev
LIGHTRAG_API_KEY=lightrag-local-dev

# Optional shared-site password for the OpenMAIC UI. Empty means disabled.
OPENMAIC_ACCESS_CODE=

# Host ports. All bindings remain loopback-only in compose.yaml.
POSTGRES_PORT=5432
OPENMAIC_PORT=3000
CATALOG_PORT=3100
LIGHTRAG_PORT=9621
DEEPTUTOR_BACKEND_PORT=8001
DEEPTUTOR_FRONTEND_PORT=3782

# Catalog → DeepTutor (server-side). Local default for `pnpm dev`.
DEEPTUTOR_WS_URL=ws://127.0.0.1:8001/api/v1/ws
# Where Catalog writes CourseArtifact snapshots on generation success.
ARTIFACT_STORE_DIR=

# DeepTutor is pinned to the reviewed version by default.
DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:1.5.10

# Optional OpenMAIC build-time feature flags.
OPENMAIC_EDITOR_ENABLED=
OPENMAIC_PI_CHAT_ENABLED=
OPENMAIC_VOCATIONAL_TEST_UI=
OPENMAIC_PPTX_IMPORT_ENABLED=

# Catalog identity: local password auth (default). Set oidc later when Authentik
# (or another IdP) is wired; BFF session + Principal stay the same.
IDENTITY_PROVIDER=local
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Optional platform profiles (compose.profiles.platform.yaml)
#   docker compose -f compose.yaml -f compose.profiles.platform.yaml \
#     --profile object-store --profile idp up -d
# Existing Postgres volumes: apply ensure-platform-databases.sql once first.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=innate-minio
MINIO_ROOT_PASSWORD=innate-minio-local-dev
MINIO_BUCKET=innate
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Generate a long random value before any non-local use.
AUTHENTIK_SECRET_KEY=change-me-authentik-local-dev-secret-key-32b
AUTHENTIK_TAG=2025.10.0
AUTHENTIK_PORT_HTTP=9002
AUTHENTIK_PORT_HTTPS=9443

# ---------------------------------------------------------------------------
# Optional BaaS spike (compose.profiles.baas-spike.yaml) — isolated Nubase.
#   docker compose -f compose.yaml -f compose.profiles.baas-spike.yaml \
#     --profile baas-nubase up -d
# Does not share innate/openmaic/lightrag tables. Prefer Authentik+MinIO for
# the product identity/object path; use Nubase only to evaluate Memory/MCP.
# ---------------------------------------------------------------------------
NUBASE_IMAGE=ottermind/nubase:latest
NUBASE_PORT=9999
NUBASE_PGRST_ENCRYPTION_MASTER_KEY=nubase-local-dev-master-key-change-me
NUBASE_METADATA_SERVICE_ROLE_KEY=nubase-local-dev-metadata-service-role
# When object-store is also up, Nubase can use MinIO via these defaults.
NUBASE_R2_ENDPOINT=http://minio:9000
NUBASE_R2_PUBLIC_URL=http://127.0.0.1:9000
NUBASE_R2_ACCOUNT_ID=local
