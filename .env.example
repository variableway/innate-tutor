# Copy to .env before the first start:
#   cp .env.example .env
#
# Local/trusted-network defaults only. Change all *-local-dev values before
# exposing any service beyond 127.0.0.1.

TZ=Asia/Shanghai

# LLM for OpenMAIC. Prefer DEFAULT_MODEL=provider:model.
# OpenAI-compatible (LLM_*) and/or Anthropic-compatible (ANTHROPIC_*).
# Local tip: copy from innate-aiswitcher providers (minimax-codex / volcengine-claude / xiaomi-claude).
# DeepTutor ignores process-level model config; set models in its Settings UI.
DEFAULT_MODEL=openai:gpt-5.4-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODELS=
# Xiaomi/MiMo Token Plan OpenAI-compatible (/v1). Example DEFAULT_MODEL=xiaomi:mimo-v2.5-pro
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MODELS=

# Optional bundled LightRAG profile. These values are ignored by the default
# no-RAG startup. Indexing requires a working embedding model and exact dimension.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LIGHTRAG_LLM_MODEL=gpt-5.4-mini

# Local infrastructure credentials. LIGHTRAG_API_KEY is needed only when the
# `rag-lightrag` profile is enabled.
POSTGRES_PASSWORD=innate-local-dev
OPENMAIC_PERSISTENCE_TOKEN=openmaic-local-dev
LIGHTRAG_API_KEY=lightrag-local-dev

# Optional shared-site password for the OpenMAIC UI. Empty means disabled.
OPENMAIC_ACCESS_CODE=

# Host ports. All bindings remain loopback-only in compose.yaml.
POSTGRES_PORT=5432
OPENMAIC_PORT=3000
CATALOG_PORT=3100
LIGHTRAG_PORT=9621
DEEPTUTOR_BACKEND_PORT=8001
DEEPTUTOR_FRONTEND_PORT=3782

# DeepTutor is pinned to the reviewed version by default.
DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:1.5.10

# Optional OpenMAIC build-time feature flags.
OPENMAIC_EDITOR_ENABLED=
OPENMAIC_PI_CHAT_ENABLED=
OPENMAIC_VOCATIONAL_TEST_UI=
OPENMAIC_PPTX_IMPORT_ENABLED=
