# Copy to .env before the first start:
#   cp .env.example .env
#
# Local/trusted-network defaults only. Change all *-local-dev values before
# exposing any service beyond 127.0.0.1.

TZ=Asia/Shanghai

# Shared OpenAI-compatible LLM endpoint used by OpenMAIC and LightRAG.
# DeepTutor intentionally ignores process-level model configuration; configure
# the same provider after startup at http://localhost:3782/settings/models.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# LightRAG indexing requires a working embedding model and the exact dimension.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LIGHTRAG_LLM_MODEL=gpt-5.4-mini

# Local infrastructure credentials.
POSTGRES_PASSWORD=innate-local-dev
OPENMAIC_PERSISTENCE_TOKEN=openmaic-local-dev
LIGHTRAG_API_KEY=lightrag-local-dev

# Optional shared-site password for the OpenMAIC UI. Empty means disabled.
OPENMAIC_ACCESS_CODE=

# Host ports. All bindings remain loopback-only in compose.yaml.
POSTGRES_PORT=5432
OPENMAIC_PORT=3000
LIGHTRAG_PORT=9621
DEEPTUTOR_BACKEND_PORT=8001
DEEPTUTOR_FRONTEND_PORT=3782

# DeepTutor is pinned to the reviewed version by default.
DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:1.5.9

# Optional OpenMAIC build-time feature flags.
OPENMAIC_EDITOR_ENABLED=
OPENMAIC_PI_CHAT_ENABLED=
OPENMAIC_VOCATIONAL_TEST_UI=
OPENMAIC_PPTX_IMPORT_ENABLED=
